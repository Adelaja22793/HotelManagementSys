{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HotelManagementDb": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "hms-api",
    "Audience": "hms-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Desktop": {
    "MinimumVersion": "0.1.0",
    "LatestVersion": "0.1.0"
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "BackgroundJobs": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "NotificationBatchSize": 50,
    "ScanBatchSize": 10
  },
  "Documents": {
    "StoragePath": "",
    "MaxBytes": 10485760,
    "AllowUnscanned": false,
    "ClamAvHost": "",
    "ClamAvPort": 3310,
    "SignatureKey": ""
  },
  "Email": {
    "Mode": "None",
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Hotel",
    "PickupDirectory": ""
  },
  "Sms": {
    "Provider": "None",
    "BaseUrl": "https://api.ng.termii.com",
    "ApiKey": "",
    "SenderId": ""
  },
  "Security": {
    "LostFoundHoldDays": 90,
    "VisitorRetentionDays": 365
  }
}
