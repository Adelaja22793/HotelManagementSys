{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HotelManagementDb": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "hms-api",
    "Audience": "hms-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Desktop": {
    "MinimumVersion": "0.1.0",
    "LatestVersion": "0.1.0"
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  }
}
