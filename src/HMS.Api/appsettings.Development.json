{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HotelManagementDb": "Server=(localdb)\\MSSQLLocalDB;Database=HotelManagementDb_Dev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true
  },
  "Bootstrap": {
    "Enabled": true,
    "CompanyName": "Demo Hotels Ltd",
    "CompanyCode": "DEMO",
    "BranchName": "Lagos Main",
    "BranchCode": "LOS",
    "TimeZoneId": "Africa/Lagos",
    "AdminFullName": "System Administrator"
  },
  "Documents": {
    "AllowUnscanned": true
  },
  "Email": {
    "Mode": "Pickup",
    "PickupDirectory": "App_Data/mail",
    "FromAddress": "noreply@localhost"
  },
  "PublicBooking": {
    "PaymentProvider": "Sandbox",
    "SiteUrl": "http://localhost:5173",
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
