<Window x:Class="HMS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HMS.Desktop.ViewModels"
        Title="Hotel Management System - Sign in"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=EmailBox}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="32">
        <TextBlock Text="Hotel Management System" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24" />

        <!-- Step 1: credentials -->
        <StackPanel x:Name="CredentialsPanel">
            <TextBlock Text="Email" />
            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Password" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,16" Padding="6" KeyDown="PasswordBox_KeyDown" />
            <Button Content="Sign in" Padding="8" IsDefault="True" Click="SignIn_Click"
                    IsEnabled="{Binding LoginCommand.CanExecute}" />
        </StackPanel>

        <!-- Step 2: branch selection -->
        <StackPanel Visibility="{Binding IsSelectingBranch, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
            <TextBlock Text="Select branch" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                      DisplayMemberPath="Name" Margin="0,4,0,12" Padding="6" />
            <Button Content="Continue" Padding="8" Command="{Binding ContinueCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,16,0,0" />
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</Window>
