<UserControl x:Class="HMS.Desktop.Views.Pages.FrontDeskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Arrivals today" />
            <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Label}" Text="Room" />
                <ComboBox ItemsSource="{Binding RoomsForArrival}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="RoomNumber" Width="160" HorizontalAlignment="Left" />
                <Button Content="Check in" Command="{Binding CheckInCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Arrivals}" SelectedItem="{Binding SelectedArrival}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Reservation" Binding="{Binding ReservationNumber}" />
                    <DataGridTextColumn Header="Guest" Binding="{Binding GuestName}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding RoomTypeCode}" />
                    <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" />
                    <DataGridTextColumn Header="Departs" Binding="{Binding DepartureDate, Converter={StaticResource DateOnly}}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="In house (departures today are listed first)" />
            <StackPanel DockPanel.Dock="Bottom">
                <CheckBox Content="Check out with balance (manager)" IsChecked="{Binding AllowBalance}" Margin="0,4"
                          Visibility="{Binding CanOverrideBalance, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding BalanceReason, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding AllowBalance, Converter={StaticResource BoolToVis}}" ToolTip="Reason for leaving a balance" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open folio" Command="{Binding OpenFolioCommand}" />
                    <Button Content="Check out" Command="{Binding CheckOutCommand}" Visibility="{Binding CanCheckOut, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <DataGrid ItemsSource="{Binding Departures}" SelectedItem="{Binding SelectedStay}" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" />
                        <DataGridTextColumn Header="Guest (leaving today)" Binding="{Binding GuestName}" Width="*" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding InHouse}" SelectedItem="{Binding SelectedStay}" MaxHeight="320">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" />
                        <DataGridTextColumn Header="Guest" Binding="{Binding GuestName}" Width="*" />
                        <DataGridTextColumn Header="Departs" Binding="{Binding DepartureDate, Converter={StaticResource DateOnly}}" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
