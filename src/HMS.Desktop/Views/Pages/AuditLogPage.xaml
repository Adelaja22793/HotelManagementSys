<UserControl x:Class="HMS.Desktop.Views.Pages.AuditLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Record type" /><TextBox Width="130" Text="{Binding EntityType, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Record id" /><TextBox Width="130" Text="{Binding EntityId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="User id" /><TextBox Width="130" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Action" /><TextBox Width="110" Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="From" /><DatePicker SelectedDate="{Binding From}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="To" /><DatePicker SelectedDate="{Binding To}" /></StackPanel>
            <Button Content="Search" Command="{Binding SearchCommand}" IsDefault="True" VerticalAlignment="Center" />
            <Button Content="Export CSV" Command="{Binding ExportCommand}" VerticalAlignment="Center" />
        </WrapPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"><Run Text="Page" /> <Run Text="{Binding Page, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="entries" /></TextBlock>
            <Button Content="Next" Command="{Binding NextPageCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Entries}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAtUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                <DataGridTextColumn Header="User" Binding="{Binding UserId}" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                <DataGridTextColumn Header="Record" Binding="{Binding EntityType}" />
                <DataGridTextColumn Header="Record id" Binding="{Binding EntityId}" />
                <DataGridTextColumn Header="Changed" Binding="{Binding ChangedProperties}" Width="*" />
                <DataGridTextColumn Header="Trace" Binding="{Binding TraceId}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
