<UserControl x:Class="HMS.Desktop.Views.Pages.StaffPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <TabControl>
        <TabItem Header="Employees">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Bottom" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Number" /><TextBox Width="80" Text="{Binding NewNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="First name" /><TextBox Width="120" Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Last name" /><TextBox Width="120" Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Department" /><ComboBox Width="150" ItemsSource="{Binding Departments}" SelectedItem="{Binding NewDepartment}" DisplayMemberPath="Name" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Job title" /><TextBox Width="140" Text="{Binding NewJobTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Hired" /><DatePicker SelectedDate="{Binding NewHireDate}" /></StackPanel>
                    <Button Content="Add employee" Command="{Binding AddEmployeeCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding EmployeeNumber}" />
                        <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" />
                        <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" />
                        <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" />
                        <DataGridTextColumn Header="Job title" Binding="{Binding JobTitle}" Width="*" />
                        <DataGridTextColumn Header="Hired" Binding="{Binding HireDate, Converter={StaticResource DateOnly}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Roster and attendance">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="◀ Previous week" Command="{Binding PreviousWeekCommand}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding WeekStart, StringFormat='Week of {0:dd MMM yyyy}'}" />
                    <Button Content="Next week ▶" Command="{Binding NextWeekCommand}" />
                    <Button Content="Clock in" Command="{Binding ClockInCommand}" ToolTip="Clocks in the employee picked on the Employees tab, or yourself" />
                    <Button Content="Clock out" Command="{Binding ClockOutCommand}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Top" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Employee" /><ComboBox Width="180" ItemsSource="{Binding Employees}" SelectedItem="{Binding Employee}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding FirstName, Mode=OneWay}" /> <Run Text="{Binding LastName, Mode=OneWay}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Shift" /><ComboBox Width="140" ItemsSource="{Binding Shifts}" SelectedItem="{Binding Shift}" DisplayMemberPath="Name" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Date" /><DatePicker SelectedDate="{Binding WorkDate}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Notes" /><TextBox Width="160" Text="{Binding RosterNotes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Add to roster" Command="{Binding AddRosterCommand}" VerticalAlignment="Center" />
                    <Button Content="Remove selected" Command="{Binding RemoveRosterCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DataGrid Margin="0,4,12,12" ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedRoster}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, Converter={StaticResource DateOnly}}" />
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*" />
                            <DataGridTextColumn Header="Shift" Binding="{Binding ShiftCode}" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Attendance}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, Converter={StaticResource DateOnly}}" />
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*" />
                            <DataGridTextColumn Header="Rostered h" Binding="{Binding RosteredHours, StringFormat=N2}" />
                            <DataGridTextColumn Header="Worked h" Binding="{Binding WorkedHours, StringFormat=N2}" />
                            <DataGridTextColumn Header="Overtime h" Binding="{Binding ApprovedOvertimeHours, StringFormat=N2}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Leave and overtime">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Employee (from the Employees tab)" /><TextBlock Width="200" Padding="0,5"><Run Text="{Binding Employee.FirstName, Mode=OneWay}" /> <Run Text="{Binding Employee.LastName, Mode=OneWay}" /></TextBlock></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Type" /><ComboBox Width="100" ItemsSource="{x:Static vm:StaffPageViewModel.LeaveTypes}" SelectedItem="{Binding LeaveType}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="First day" /><DatePicker SelectedDate="{Binding LeaveStart}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Last day" /><DatePicker SelectedDate="{Binding LeaveEnd}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Reason" /><TextBox Width="180" Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Request leave" Command="{Binding RequestLeaveCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Leave" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="Approve" Command="{Binding ApproveLeaveCommand}" />
                            <Button Content="Reject" Command="{Binding RejectLeaveCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Leave}" SelectedItem="{Binding SelectedLeave}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="From" Binding="{Binding StartDate, Converter={StaticResource DateOnly}}" />
                                <DataGridTextColumn Header="To" Binding="{Binding EndDate, Converter={StaticResource DateOnly}}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Overtime" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <Button Content="Approve" Command="{Binding ApproveOvertimeCommand}" />
                            <Button Content="Reject" Command="{Binding RejectOvertimeCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Overtime}" SelectedItem="{Binding SelectedOvertime}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, Converter={StaticResource DateOnly}}" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=N2}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Handovers">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Department" /><ComboBox Width="150" ItemsSource="{Binding Departments}" SelectedItem="{Binding HandoverDepartment}" DisplayMemberPath="Name" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Notes for the next shift" /><TextBox Width="320" Text="{Binding HandoverNotes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Open issues" /><TextBox Width="220" Text="{Binding OpenIssues, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Save handover" Command="{Binding WriteHandoverCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Acknowledge" Command="{Binding AcknowledgeCommand}" />
                <DataGrid ItemsSource="{Binding Handovers}" SelectedItem="{Binding SelectedHandover}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, Converter={StaticResource DateOnly}}" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                        <DataGridTextColumn Header="Open issues" Binding="{Binding OpenIssues}" />
                        <DataGridTextColumn Header="Read (UTC)" Binding="{Binding AcknowledgedAtUtc, StringFormat=g}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
