<UserControl x:Class="HMS.Desktop.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBox Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Search" Command="{Binding SearchCommand}" IsDefault="True" Margin="8,0,8,6" />
                <Button Content="New user" Command="{Binding NewCommand}" Margin="0,0,8,6" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" />
                    <DataGridCheckBoxColumn Header="Must change password" Binding="{Binding MustChangePassword}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Account" />
                <TextBlock Style="{StaticResource Label}" Text="Email" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" />
                <TextBlock Style="{StaticResource Label}" Text="Full name" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" />
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="One-time password (at least 12 characters; they change it at first sign-in)" />
                    <TextBox Text="{Binding TemporaryPassword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="Roles" />
                <ItemsControl ItemsSource="{Binding Roles}">
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Branches" />
                <ItemsControl ItemsSource="{Binding Branches}">
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Create user" Command="{Binding CreateCommand}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Save access" Command="{Binding SaveAccessCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
