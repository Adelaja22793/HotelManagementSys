<UserControl x:Class="HMS.Desktop.Views.Pages.DocumentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Title" /><TextBox Width="220" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Category" />
                <ComboBox Width="150" ItemsSource="{x:Static vm:DocumentsPageViewModel.Categories}" SelectedItem="{Binding NewCategory}" /></StackPanel>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Classification" />
                <ComboBox Width="120" ItemsSource="{x:Static vm:DocumentsPageViewModel.Classifications}" SelectedItem="{Binding NewClassification}" /></StackPanel>
            <Button Content="Upload file…" Command="{Binding UploadCommand}" VerticalAlignment="Center" />
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <DataGrid Margin="0,4,12,12" ItemsSource="{Binding Documents}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                    <DataGridTextColumn Header="Class" Binding="{Binding Classification}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="Version" Binding="{Binding LatestVersionNumber}" />
                    <DataGridCheckBoxColumn Header="Hold" Binding="{Binding LegalHold}" />
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource NotNullToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versions" />
                    <DataGrid Height="130" ItemsSource="{Binding Selected.Versions}" SelectedItem="{Binding SelectedVersion}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding VersionNumber}" />
                            <DataGridTextColumn Header="File" Binding="{Binding OriginalFileName}" Width="*" />
                            <DataGridTextColumn Header="Scan" Binding="{Binding ScanStatus}" />
                            <DataGridTextColumn Header="Approval" Binding="{Binding Approval}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Download…" Command="{Binding DownloadCommand}" />
                        <Button Content="New version…" Command="{Binding AddVersionCommand}" />
                        <Button Content="Rescan" Command="{Binding RescanCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Approval note (required to reject)" />
                        <TextBox Text="{Binding DecisionNote, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Approve" Command="{Binding ApproveCommand}" />
                            <Button Content="Reject" Command="{Binding RejectCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Signatures" />
                    <DataGrid Height="100" ItemsSource="{Binding Signatures}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Signed by" Binding="{Binding SignerName}" />
                            <DataGridTextColumn Header="For" Binding="{Binding Purpose}" Width="*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" />
                            <DataGridCheckBoxColumn Header="Valid" Binding="{Binding IsValid}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="220" Text="{Binding SignPurpose, UpdateSourceTrigger=PropertyChanged}" ToolTip="What you are signing for" />
                        <Button Content="Sign version" Command="{Binding SignCommand}" Margin="8,0,8,6" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Retention" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Keep until" /><DatePicker SelectedDate="{Binding RetentionUntil}" /></StackPanel>
                            <CheckBox Content="Legal hold" IsChecked="{Binding LegalHold}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Save" Command="{Binding SaveRetentionCommand}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Delete document" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
