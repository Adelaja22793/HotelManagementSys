<UserControl x:Class="HMS.Desktop.Views.Pages.FolioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="240" Text="{Binding ReservationNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reservation number or guest name" />
            <Button Content="Find folio" Command="{Binding FindCommand}" IsDefault="True" Margin="8,0,0,8" />
        </StackPanel>
        <Grid Visibility="{Binding Folio, Converter={StaticResource NotNullToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"><Run Text="{Binding Folio.FolioNumber, Mode=OneWay}" />  <Run Text="{Binding Folio.GuestName, Mode=OneWay}" />  (<Run Text="{Binding Folio.Status, Mode=OneWay}" />)</TextBlock>
                    <WrapPanel>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Charges" /><TextBlock FontSize="18" Text="{Binding Folio.TotalCharges, StringFormat=N2}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Paid" /><TextBlock FontSize="18" Text="{Binding Folio.ConfirmedPayments, StringFormat=N2}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Awaiting verification" /><TextBlock FontSize="18" Text="{Binding Folio.PendingPayments, StringFormat=N2}" /></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Balance" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Folio.Balance, StringFormat=N2}" /></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Charges" />
                    <DataGrid ItemsSource="{Binding Folio.Charges}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, Converter={StaticResource DateOnly}}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" />
                            <DataGridTextColumn Header="Reversed" Binding="{Binding IsReversed}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Payments" />
                    <DataGrid ItemsSource="{Binding Folio.Payments}" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAtUtc, StringFormat=g}" />
                            <DataGridTextColumn Header="Tender" Binding="{Binding Tender}" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding ExternalReference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Refunds" />
                    <DataGrid ItemsSource="{Binding Folio.Refunds}" MaxHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding RefundNumber}" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2">
                <StackPanel Visibility="{Binding CanPost, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Post a service" />
                    <ComboBox ItemsSource="{Binding ServiceItems}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" />
                    <TextBlock Style="{StaticResource Label}" Text="Quantity" />
                    <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding Quantity}" />
                    <Button Content="Post charge" Command="{Binding PostChargeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Visibility="{Binding CanPay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Take a payment" />
                    <ComboBox ItemsSource="{x:Static vm:FolioPageViewModel.Tenders}" SelectedItem="{Binding Tender}" />
                    <TextBlock Style="{StaticResource Label}" Text="Amount" />
                    <TextBox Text="{Binding PaymentAmount, TargetNullValue=''}" />
                    <TextBlock Style="{StaticResource Label}" Text="POS slip or transfer reference" />
                    <TextBox Text="{Binding PaymentReference}" />
                    <Button Content="Record payment" Command="{Binding RecordPaymentCommand}" HorizontalAlignment="Left" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Cash needs your open cashier shift. Card and transfer payments are confirmed by a supervisor." />
                </StackPanel>
                <StackPanel Visibility="{Binding CanRefund, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Request a refund" />
                    <TextBlock Style="{StaticResource Label}" Text="Amount" />
                    <TextBox Text="{Binding RefundAmount, TargetNullValue=''}" />
                    <TextBlock Style="{StaticResource Label}" Text="Reason" />
                    <TextBox Text="{Binding RefundReason}" />
                    <Button Content="Request refund" Command="{Binding RequestRefundCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
