<UserControl x:Class="HMS.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Visibility="{Binding CanSeeFrontDesk, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Today.BusinessDate, Converter={StaticResource DateOnly}, StringFormat=Business date {0}}" />
                <WrapPanel>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Arrivals" />
                        <TextBlock FontSize="20"><Run Text="{Binding Today.ArrivalsCheckedIn, Mode=OneWay}" /> / <Run Text="{Binding Today.ArrivalsExpected, Mode=OneWay}" /></TextBlock></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Departures" />
                        <TextBlock FontSize="20"><Run Text="{Binding Today.DeparturesCheckedOut, Mode=OneWay}" /> / <Run Text="{Binding Today.DeparturesExpected, Mode=OneWay}" /></TextBlock></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="In house" />
                        <TextBlock FontSize="20" Text="{Binding Today.InHouse}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Vacant clean" />
                        <TextBlock FontSize="20" Text="{Binding Today.VacantClean}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Vacant dirty" />
                        <TextBlock FontSize="20" Text="{Binding Today.VacantDirty}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Blocked" />
                        <TextBlock FontSize="20" Text="{Binding Today.Blocked}" /></StackPanel></Border>
                </WrapPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding CanSeeMetrics, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Last 7 days" />
                <WrapPanel>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Occupancy" />
                        <TextBlock FontSize="20" Text="{Binding Week.Totals.Occupancy, StringFormat={}{0:P1}}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="ADR" />
                        <TextBlock FontSize="20" Text="{Binding Week.Totals.Adr, StringFormat=N2}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="RevPAR" />
                        <TextBlock FontSize="20" Text="{Binding Week.Totals.RevPar, StringFormat=N2}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Room revenue" />
                        <TextBlock FontSize="20" Text="{Binding Week.Totals.RoomRevenue, StringFormat=N2}" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Collections" />
                        <TextBlock FontSize="20" Text="{Binding Week.Totals.Collections, StringFormat=N2}" /></StackPanel></Border>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Week.Days}" MaxHeight="320">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateOnly}}" />
                        <DataGridTextColumn Header="Sold" Binding="{Binding RoomsSold}" />
                        <DataGridTextColumn Header="Available" Binding="{Binding RoomsAvailable}" />
                        <DataGridTextColumn Header="Occupancy" Binding="{Binding Occupancy, StringFormat={}{0:P1}}" />
                        <DataGridTextColumn Header="ADR" Binding="{Binding Adr, StringFormat=N2}" />
                        <DataGridTextColumn Header="Room revenue" Binding="{Binding RoomRevenue, StringFormat=N2}" />
                        <DataGridTextColumn Header="Other revenue" Binding="{Binding OtherRevenue, StringFormat=N2}" />
                        <DataGridTextColumn Header="Collections" Binding="{Binding Collections, StringFormat=N2}" />
                        <DataGridTextColumn Header="Final" Binding="{Binding IsFinal}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
