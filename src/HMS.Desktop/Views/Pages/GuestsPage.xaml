<UserControl x:Class="HMS.Desktop.Views.Pages.GuestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name, email or phone" />
                <Button Content="Search" Command="{Binding SearchCommand}" IsDefault="True" Margin="8,0,0,8" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding Guest, Converter={StaticResource NotNullToVis}}">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Style="{StaticResource Label}" Text="First name" /><TextBox Text="{Binding FirstName}" />
                <TextBlock Style="{StaticResource Label}" Text="Last name" /><TextBox Text="{Binding LastName}" />
                <TextBlock Style="{StaticResource Label}" Text="Email" /><TextBox Text="{Binding Email}" />
                <TextBlock Style="{StaticResource Label}" Text="Phone" /><TextBox Text="{Binding Phone}" />
                <TextBlock Style="{StaticResource Label}" Text="Nationality" /><TextBox Text="{Binding Nationality}" />
                <TextBlock Style="{StaticResource Label}" Text="ID document type" /><TextBox Text="{Binding IdDocumentType}" />
                <TextBlock Style="{StaticResource Label}" Text="ID document number" /><TextBox Text="{Binding IdDocumentNumber}" />
                <TextBlock Style="{StaticResource Label}" Text="Address" /><TextBox Text="{Binding Address}" />
                <TextBlock Style="{StaticResource Label}" Text="Notes" /><TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
