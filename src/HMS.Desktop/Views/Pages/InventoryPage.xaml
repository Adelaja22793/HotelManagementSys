<UserControl x:Class="HMS.Desktop.Views.Pages.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Stock">
            <DockPanel Margin="8">
                <CheckBox DockPanel.Dock="Top" Content="Below reorder level only" IsChecked="{Binding BelowReorderOnly}" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Quantity" />
                        <TextBox Width="80" Text="{Binding AdjustQuantity, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Reason" />
                        <TextBox Width="260" Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Record wastage" Command="{Binding RecordWastageCommand}" VerticalAlignment="Center" />
                    <Button Content="Record count" Command="{Binding RecordCountCommand}" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid DockPanel.Dock="Bottom" Height="160" ItemsSource="{Binding Movements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, Converter={StaticResource DateOnly}}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationCode}" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" />
                        <DataGridTextColumn Header="Cost" Binding="{Binding TotalCost, StringFormat=N2}" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Balances}" SelectedItem="{Binding SelectedBalance}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" />
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationCode}" />
                        <DataGridTextColumn Header="On hand" Binding="{Binding Quantity, StringFormat=N2}" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" />
                        <DataGridTextColumn Header="Avg cost" Binding="{Binding AverageCost, StringFormat=N2}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" />
                        <DataGridCheckBoxColumn Header="Reorder" Binding="{Binding BelowReorderLevel}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Requisitions">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}">
                    <Button Content="Approve" Command="{Binding ApproveRequisitionCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Reason for rejecting" />
                        <TextBox Width="260" Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Reject" Command="{Binding RejectRequisitionCommand}" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Requisitions}" SelectedItem="{Binding SelectedRequisition}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding RequisitionNumber}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Lines" Binding="{Binding Lines.Count}" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                        <DataGridTextColumn Header="Rejected because" Binding="{Binding RejectionReason}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Purchase orders">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button Content="Approve" Command="{Binding ApproveOrderCommand}" VerticalAlignment="Center"
                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Margin="0,0,8,0" Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Label}" Text="Delivery note" />
                        <TextBox Width="180" Text="{Binding DeliveryNote, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Receive all outstanding" Command="{Binding ReceiveAllCommand}" VerticalAlignment="Center"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <DataGrid DockPanel.Dock="Bottom" Height="150" ItemsSource="{Binding SelectedOrder.Lines}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" />
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="Ordered" Binding="{Binding Quantity, StringFormat=N2}" />
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat=N2}" />
                        <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, Converter={StaticResource DateOnly}}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
