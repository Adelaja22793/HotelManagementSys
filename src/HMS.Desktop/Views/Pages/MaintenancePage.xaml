<UserControl x:Class="HMS.Desktop.Views.Pages.MaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <TabControl>
        <TabItem Header="Requests">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Report a fault" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="What is wrong" />
                            <TextBox Width="240" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Details" />
                            <TextBox Width="240" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Priority" />
                            <ComboBox Width="100" ItemsSource="{x:Static vm:MaintenancePageViewModel.Priorities}" SelectedItem="{Binding NewPriority}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Room" />
                            <ComboBox Width="90" ItemsSource="{Binding Rooms}" SelectedItem="{Binding NewRoom}" DisplayMemberPath="RoomNumber" /></StackPanel>
                        <Button Content="Report" Command="{Binding ReportCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Take the room out of service until" IsChecked="{Binding TakeRoomOutOfService}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding ExpectedReady}" />
                        <Button Content="Accept as work order" Command="{Binding AcceptCommand}" Margin="12,0,8,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Reason for rejecting" />
                            <TextBox Width="300" Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Content="Reject" Command="{Binding RejectCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fault" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Reported (UTC)" Binding="{Binding ReportedAtUtc, StringFormat=g}" />
                        <DataGridTextColumn Header="Rejected because" Binding="{Binding RejectionReason}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Work orders">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanWork, Converter={StaticResource BoolToVis}}">
                        <Button Content="Start" Command="{Binding StartCommand}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Labour hours" />
                            <TextBox Width="70" Text="{Binding LabourHours, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Labour cost" />
                            <TextBox Width="90" Text="{Binding LabourCost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="What was done" />
                            <TextBox Width="260" Text="{Binding CompletionNotes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <Button Content="Finish" Command="{Binding FinishCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                        <Button Content="Sign off" Command="{Binding SignOffCommand}" />
                        <Button Content="Send back" Command="{Binding SendBackCommand}" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding WorkOrders}" SelectedItem="{Binding SelectedWorkOrder}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding WorkOrderNumber}" />
                        <DataGridTextColumn Header="Job" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Labour" Binding="{Binding LabourCost, StringFormat=N2}" />
                        <DataGridTextColumn Header="Parts" Binding="{Binding PartsCost, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
