<UserControl x:Class="HMS.Desktop.Views.Pages.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core">
    <TabControl>
        <TabItem Header="Incidents">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Type" /><ComboBox Width="110" ItemsSource="{x:Static vm:SecurityPageViewModel.IncidentTypes}" SelectedItem="{Binding IncidentType}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Severity" /><ComboBox Width="90" ItemsSource="{x:Static vm:SecurityPageViewModel.Severities}" SelectedItem="{Binding Severity}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Title" /><TextBox Width="180" Text="{Binding IncidentTitle, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="What happened" /><TextBox Width="260" Text="{Binding IncidentDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Where" /><TextBox Width="120" Text="{Binding IncidentLocation, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Log incident" Command="{Binding ReportIncidentCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Note or resolution" /><TextBox Width="320" Text="{Binding CaseNote, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Add note" Command="{Binding AddNoteCommand}" VerticalAlignment="Center" />
                    <Button Content="Resolve" Command="{Binding ResolveCommand}" VerticalAlignment="Center" />
                    <Button Content="Close" Command="{Binding CloseIncidentCommand}" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid DockPanel.Dock="Bottom" Height="120" ItemsSource="{Binding SelectedIncident.Actions}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When (UTC)" Binding="{Binding AtUtc, StringFormat=g}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding IncidentNumber}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAtUtc, StringFormat=g}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Lost and found">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Item" /><TextBox Width="200" Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Found at" /><TextBox Width="140" Text="{Binding FoundLocation, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Stored at" /><TextBox Width="140" Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <CheckBox Content="Valuable" IsChecked="{Binding IsValuable}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Log item" Command="{Binding RecordItemCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Collected by" /><TextBox Width="160" Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Identity check" /><TextBox Width="160" Text="{Binding IdentityCheck, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Return to owner" Command="{Binding ReturnItemCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Disposal reason" /><TextBox Width="180" Text="{Binding DisposalReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Dispose" Command="{Binding DisposeItemCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding LostItems}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding ItemNumber}" />
                        <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Found at" Binding="{Binding FoundLocation}" />
                        <DataGridTextColumn Header="Stored at" Binding="{Binding StorageLocation}" />
                        <DataGridCheckBoxColumn Header="Valuable" Binding="{Binding IsValuable}" />
                        <DataGridTextColumn Header="Found (UTC)" Binding="{Binding FoundAtUtc, StringFormat=g}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Visitors">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Name" /><TextBox Width="180" Text="{Binding VisitorName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Phone" /><TextBox Width="130" Text="{Binding VisitorPhone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="ID checked" /><TextBox Width="120" Text="{Binding IdChecked, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Purpose" /><TextBox Width="200" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Sign in" Command="{Binding SignInVisitorCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="Sign out" Command="{Binding SignOutVisitorCommand}" />
                <DataGrid ItemsSource="{Binding Visitors}" SelectedItem="{Binding SelectedVisitor}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Visitor" Binding="{Binding VisitorName}" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" />
                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="*" />
                        <DataGridTextColumn Header="Arrived (UTC)" Binding="{Binding ArrivedAtUtc, StringFormat=g}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Emergencies">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Type" /><ComboBox Width="120" ItemsSource="{x:Static vm:SecurityPageViewModel.EmergencyTypes}" SelectedItem="{Binding EmergencyType}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Description" /><TextBox Width="320" Text="{Binding EmergencyDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Declare emergency" Command="{Binding DeclareEmergencyCommand}" VerticalAlignment="Center" Foreground="#B42318" />
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom">
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Action taken" /><TextBox Width="260" Text="{Binding EmergencyAction, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="Log action" Command="{Binding LogActionCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Label}" Text="Summary" /><TextBox Width="260" Text="{Binding EmergencySummary, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    <Button Content="End emergency" Command="{Binding EndEmergencyCommand}" VerticalAlignment="Center" />
                </WrapPanel>
                <DataGrid DockPanel.Dock="Bottom" Height="120" ItemsSource="{Binding SelectedEmergency.Actions}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When (UTC)" Binding="{Binding AtUtc, StringFormat=g}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid ItemsSource="{Binding Emergencies}" SelectedItem="{Binding SelectedEmergency}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedAtUtc, StringFormat=g}" />
                        <DataGridTextColumn Header="Ended (UTC)" Binding="{Binding EndedAtUtc, StringFormat=g}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
