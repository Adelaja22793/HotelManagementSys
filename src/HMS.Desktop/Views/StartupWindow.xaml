<Window x:Class="HMS.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Management System"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="32">
        <TextBlock Text="Hotel Management System" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- First run only: create the hotel and its first administrator. -->
        <StackPanel Visibility="{Binding IsSetupNeeded, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Welcome. Set up your hotel once, and HMS remembers it on this PC."
                       TextWrapping="Wrap" Foreground="#52606D" Margin="0,0,0,16" />
            <TextBlock Text="Hotel name" />
            <TextBox x:Name="HotelBox" Text="{Binding HotelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Branch name" />
            <TextBox Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Administrator's full name" />
            <TextBox Text="{Binding AdminFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Administrator's email (used to sign in)" />
            <TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Password (12+ characters, with upper and lower case and a number)" TextWrapping="Wrap" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" Padding="6" />
            <TextBlock Text="Confirm password" />
            <PasswordBox x:Name="ConfirmBox" Margin="0,4,0,16" Padding="6" />
            <Button Content="Set up and open HMS" Padding="8" IsDefault="True" Click="Setup_Click"
                    IsEnabled="{Binding IsIdle}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0" />
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Visibility="{Binding ShowLocalDbHelp, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0" TextWrapping="Wrap">
            <Hyperlink Click="LocalDbLink_Click">How to install SQL Server Express LocalDB</Hyperlink>
        </TextBlock>
        <Expander Header="Details" Margin="0,8,0,0"
                  Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
        </Expander>
        <Button Content="Try again" Padding="8" Margin="0,12,0,0" Click="Retry_Click"
                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</Window>
