<Window x:Class="HMS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F3A5F" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sign out" Command="{Binding SignOutCommand}" Margin="0" />
                <Button DockPanel.Dock="Right" Content="Refresh (F5)" Command="{Binding RefreshCommand}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Session.Branch.Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="  |  " Foreground="#9FB3C8" FontSize="16" />
                    <TextBlock Text="{Binding Session.User.FullName}" Foreground="#D9E2EC" FontSize="16" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox DockPanel.Dock="Left" Width="230" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                 BorderThickness="0" Background="#F0F4F8">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="Padding" Value="10,7" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="Not yet on the desktop" Foreground="Gray" FontSize="11"
                                   Visibility="{Binding PageType, Converter={StaticResource NotNullToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Margin="24,16">
            <StackPanel DockPanel.Dock="Top" DataContext="{Binding CurrentPage}">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Border Background="#FDECEA" Padding="10,6" Margin="0,8,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#8A1C1C" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TraceId, StringFormat=Reference for support: {0}}" Foreground="#8A1C1C" FontSize="11"
                                   Visibility="{Binding TraceId, Converter={StaticResource NotNullToVis}}" />
                    </StackPanel>
                </Border>
                <Border Background="#E3F9E5" Padding="10,6" Margin="0,8,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#05400A" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <!-- The screen's tasks: each button opens its form on the right. -->
            <ItemsControl DockPanel.Dock="Top" DataContext="{Binding CurrentPage}" ItemsSource="{Binding Actions}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Margin="0,0,8,6"
                                Command="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border DockPanel.Dock="Right" Width="360" Margin="12,12,0,0" Padding="14" Background="#F5F7FA" CornerRadius="4"
                    DataContext="{Binding CurrentPage}" Visibility="{Binding IsActionOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel DataContext="{Binding OpenAction}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Foreground="#52606D" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Description, Converter={StaticResource NotNullToVis}}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Error}" Foreground="#8A1C1C" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" IsDefault="True"
                                    Command="{Binding DataContext.SubmitActionCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                            <Button Content="Cancel"
                                    Command="{Binding DataContext.CloseActionCommand, RelativeSource={RelativeSource AncestorType=Border}}" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" />
                            <StackPanel Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LinesTitle}" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding LineFields}" Focusable="False" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Add line" Command="{Binding AddLineCommand}" />
                                    <Button Content="Remove line" Command="{Binding RemoveLineCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" DisplayMemberPath="Label" MinHeight="40" MaxHeight="160" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="0,12,0,0" Focusable="False" />
        </DockPanel>
    </DockPanel>
</Window>
