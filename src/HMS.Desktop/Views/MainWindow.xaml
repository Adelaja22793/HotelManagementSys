<Window x:Class="HMS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1200" Height="760"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F3A5F" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sign out" Padding="10,4" Command="{Binding SignOutCommand}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Session.Branch.Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="  |  " Foreground="#9FB3C8" FontSize="16" />
                    <TextBlock Text="{Binding Session.User.FullName}" Foreground="#D9E2EC" FontSize="16" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox DockPanel.Dock="Left" Width="240" ItemsSource="{Binding Modules}" BorderThickness="0" Background="#F0F4F8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Foreground="Gray" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Phase, StringFormat=Coming in phase {0}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                            <Setter Property="Text" Value="Available" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Margin="32">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                       Text="Signed in. Operational modules appear here as each delivery phase is completed." />
        </StackPanel>
    </DockPanel>
</Window>
