<Application x:Class="HMS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core"
             xmlns:pages="clr-namespace:HMS.Desktop.Views.Pages"
             xmlns:conv="clr-namespace:HMS.Desktop.Converters"
             xmlns:setup="clr-namespace:HMS.Desktop.ViewModels.Setup;assembly=HMS.Desktop.Core"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <conv:DateOnlyConverter x:Key="DateOnly" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E7EB" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <!-- One input on a Setup or task form; which control shows depends on the kind of value. -->
        <DataTemplate DataType="{x:Type setup:FormField}">
            <StackPanel Margin="0,0,0,2">
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Label}" TextWrapping="Wrap"
                           Visibility="{Binding ShowsCaption, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsLongText, Converter={StaticResource BoolToVis}}" />
                <PasswordBox PasswordChanged="FormPassword_Changed" Margin="0,2,0,8" Padding="4,3"
                             Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}" />
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Flag}" Margin="0,4,0,8"
                          Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}" />
                <DatePicker SelectedDate="{Binding Date}"
                            Visibility="{Binding IsDate, Converter={StaticResource BoolToVis}}" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                          IsEditable="{Binding AllowsOwnValue}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                          Visibility="{Binding IsPicker, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Hint}" Foreground="#7B8794" FontSize="11" Margin="0,-6,0,6" TextWrapping="Wrap"
                           Visibility="{Binding Hint, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Each page view model is shown by its view. -->
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}"><pages:DashboardPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrontDeskPageViewModel}"><pages:FrontDeskPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReservationsPageViewModel}"><pages:ReservationsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolioPageViewModel}"><pages:FolioPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashierPageViewModel}"><pages:CashierPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HousekeepingPageViewModel}"><pages:HousekeepingPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomsPageViewModel}"><pages:RoomsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupPageViewModel}"><pages:SetupPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuestsPageViewModel}"><pages:GuestsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestaurantPageViewModel}"><pages:RestaurantPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenancePageViewModel}"><pages:MaintenancePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryPageViewModel}"><pages:InventoryPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffPageViewModel}"><pages:StaffPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingPageViewModel}"><pages:AccountingPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NightAuditPageViewModel}"><pages:NightAuditPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsPageViewModel}"><pages:DocumentsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityPageViewModel}"><pages:SecurityPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersPageViewModel}"><pages:UsersPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogPageViewModel}"><pages:AuditLogPage /></DataTemplate>
    </Application.Resources>
</Application>
