<Application x:Class="HMS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HMS.Desktop.ViewModels;assembly=HMS.Desktop.Core"
             xmlns:pages="clr-namespace:HMS.Desktop.Views.Pages"
             xmlns:conv="clr-namespace:HMS.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <conv:DateOnlyConverter x:Key="DateOnly" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E7EB" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <!-- Each page view model is shown by its view. -->
        <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}"><pages:DashboardPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrontDeskPageViewModel}"><pages:FrontDeskPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReservationsPageViewModel}"><pages:ReservationsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolioPageViewModel}"><pages:FolioPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashierPageViewModel}"><pages:CashierPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HousekeepingPageViewModel}"><pages:HousekeepingPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoomsPageViewModel}"><pages:RoomsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuestsPageViewModel}"><pages:GuestsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestaurantPageViewModel}"><pages:RestaurantPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenancePageViewModel}"><pages:MaintenancePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryPageViewModel}"><pages:InventoryPage /></DataTemplate>
    </Application.Resources>
</Application>
